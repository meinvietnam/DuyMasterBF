-- [SỬ LỖI NẰM BÒ RA ĐẤT KHI CHƠI LÂU (ANTI-RAGDOLL)]
-- Di chuyển kiểm tra trạng thái ra khỏi RenderStepped, chạy luồng riêng 0.2s/lần để triệt tiêu LAG hoàn toàn
task.spawn(function()
    while true do
        task.wait(0.2)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStanding = false
            local state = hum:GetState()
            if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end
end)

-- Điều hướng bay 3D mượt mà
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if states.fly and hrp and hum and bv and bg then
        local cam = workspace.CurrentCamera
        local moveDir = hum.MoveDirection
        
        local lookVec = cam.CFrame.LookVector
        bg.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(lookVec.X, 0, lookVec.Z))
        
        if moveDir.Magnitude > 0 then
            local lookVector = cam.CFrame.LookVector
            local rightVector = cam.CFrame.RightVector
            
            local forwardSpeed = -moveDir:Dot(cam.CFrame.LookVector)
            local sideSpeed = moveDir:Dot(cam.CFrame.RightVector)
            
            bv.Velocity = (lookVector * -forwardSpeed * flySpeed) + (rightVector * sideSpeed * flySpeed)
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

