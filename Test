local posHistory = {}

local function AddToHistory(coords)
    if #posHistory > 0 and posHistory[1] == coords then return end
    table.insert(posHistory, 1, coords)
    if #posHistory > 5 then
        table.remove(posHistory, 6)
    end
    
    -- Xóa UI cũ để tránh chồng chéo bộ nhớ
    for _, item in pairs(HistoryFrame:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end
    
    -- Vẽ danh sách lịch sử mới
    for i, hCoords in ipairs(posHistory) do
        local hBtn = Instance.new("TextButton")
        hBtn.Text = string.format("Vị Trí %d: %s", i, hCoords)
        hBtn.Size = UDim2.new(0.96, 0, 0, 24)
        hBtn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
        hBtn.BorderSizePixel = 1
        hBtn.BorderColor3 = Color3.fromRGB(200, 200, 200)
        hBtn.Font = Enum.Font.SourceSansBold
        hBtn.TextSize = 12
        hBtn.TextColor3 = Color3.fromRGB(50, 50, 50)
        hBtn.ZIndex = 6
        hBtn.Parent = HistoryFrame
        
        hBtn.MouseButton1Click:Connect(function()
            PosInput.Text = hCoords
            HistoryFrame.Visible = false
        end)
    end
end

