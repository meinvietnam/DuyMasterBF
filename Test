-- Hàm tự tắt toàn bộ hệ thống khi nhân vật chết và ngắt kết nối hoàn toàn để giải phóng RAM
local function ResetOnDeath()
    states.fly = false
    states.spamTool = false
    states.spamClick = false
    states.spamTP = false
    states.fling = false
    
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    
    -- Giải phóng vùng nhớ Fling ngay lập tức
    if flingPart then flingPart:Destroy() flingPart = nil end
    if flingAngular then flingAngular:Destroy() flingAngular = nil end
    if flingVelocity then flingVelocity:Destroy() flingVelocity = nil end
    
    BtnVFly.Text = "V-FLY: OFF"
    BtnVFly.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    BtnSpamTool.Text = "SPAM TOOL"
    BtnSpamTool.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    BtnSpamClick.Text = "SPAM CLICK"
    BtnSpamClick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    BtnSpamTP.Text = "SPAM TP: OFF"
    BtnSpamTP.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    BtnFling.Text = "FLING: OFF"
    BtnFling.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
end

local function TrackDeath(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.Died:Connect(function()
            ResetOnDeath()
        end)
    end
end
if LocalPlayer.Character then TrackDeath(LocalPlayer.Character) end
