        flingPart.CanCollide = false
        flingPart.Massless = true
        flingPart.Parent = char
        
        flingAngular = Instance.new("BodyAngularVelocity")
        flingAngular.MaxTorque = Vector3.new(0, 9e9, 0)
        flingAngular.AngularVelocity = Vector3.new(0, 100000, 0)
